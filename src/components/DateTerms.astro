---
// A dateRange may list several discrete terms ("Fall 2022, Fall 2023"). The
// date column is 130px — too narrow for two terms — and left alone the browser
// fills greedily and breaks inside one: "Fall 2022, Fall" / "2023". Each term
// gets its own nowrap span, with the break opportunity in the space between
// them, so a line can only ever end at a comma.
//
// Renders the spans only; the caller supplies the .date wrapper, whose font and
// colour these inherit.
interface Props {
  value: string;
}

const { value } = Astro.props;
const terms = value.split(', ');
---

{
  terms.map((term, i) => (
    <>
      <span class="term">
        {term}
        {i < terms.length - 1 ? ',' : ''}
      </span>
      {i < terms.length - 1 ? ' ' : ''}
    </>
  ))
}

<style>
  .term {
    white-space: nowrap;
  }
</style>
