---
// "last updated" is stamped at build time, so it tracks the latest deploy.
const now = new Date();
const lastUpdated = `${now.getFullYear()}–${String(now.getMonth() + 1).padStart(2, '0')}`;
---

<footer class="footer">
  <div class="inner">last updated: {lastUpdated}</div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: clamp(28px, 4vw, 40px) var(--gutter);
  }

  .inner {
    max-width: var(--content-width);
    margin-inline: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
  }
</style>
