---
// Pill toggle in the nav: dot + "dark"/"light" label.
//
// The visible label is driven purely by CSS off <html data-theme>, not by JS
// text swapping — that's what keeps it in sync with the pre-paint theme-init
// script in BaseLayout and avoids a flash of the wrong label on load.
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch color theme">
  <span class="dot" aria-hidden="true"></span>
  <span class="label label-dark">dark</span>
  <span class="label label-light">light</span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid var(--border-tag);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 3px;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text-primary);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: currentColor;
    display: inline-block;
  }

  /* Dark = filled dot + "dark"; light = hollow dot + "light". */
  .label-light {
    display: none;
  }

  :global(html[data-theme='light']) .dot {
    background: transparent;
  }

  :global(html[data-theme='light']) .label-dark {
    display: none;
  }

  :global(html[data-theme='light']) .label-light {
    display: inline;
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  if (btn) {
    const syncLabel = () => {
      const isLight = root.dataset.theme === 'light';
      btn.setAttribute(
        'aria-label',
        isLight ? 'Switch to dark theme' : 'Switch to light theme'
      );
    };

    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('site-theme', next);
      } catch {
        /* private mode / storage disabled — theme still applies for this page */
      }
      syncLabel();
    });

    syncLabel();
  }
</script>
