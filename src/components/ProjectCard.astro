---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { name, description, featured, languages, tags, links } = entry.data;

// Only the link types present in frontmatter render, in this fixed order.
// The label is what the link leads to, not where it's hosted — hence `code`
// for the repository, matching the publication entries' link row.
const linkOrder = ['github', 'demo', 'paper'] as const;
const linkLabels: Record<(typeof linkOrder)[number], string> = {
  github: 'code',
  demo: 'demo',
  paper: 'paper',
};
const presentLinks = linkOrder
  .map((kind) => ({ kind, href: links[kind] }))
  .filter((l): l is { kind: (typeof linkOrder)[number]; href: string } => Boolean(l.href));
---

<article class="card">
  <h3>
    {
      featured && (
        <svg
          class="star"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="currentColor"
          role="img"
          aria-label="Selected project"
        >
          <path d="M12 2.5l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.35l-5.81 3.05 1.11-6.47-4.7-4.58 6.5-.95z" />
        </svg>
      )
    }
    {name}
  </h3>

  <p class="description">{description}</p>

  {
    languages.length > 0 && (
      <div class="languages">
        {languages.map((language) => (
          <span class="language">
            <span class="dot" aria-hidden="true" />
            {language}
          </span>
        ))}
      </div>
    )
  }

  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }

  {
    presentLinks.length > 0 && (
      <div class="links">
        {presentLinks.map((link) => (
          <a href={link.href}>{linkLabels[link.kind]}</a>
        ))}
      </div>
    )
  }

  <slot />
</article>

<style>
  .card {
    border: 1px solid var(--border-strong);
    background: var(--bg-card);
    padding: 24px;
    border-radius: 3px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* h3, not h2: each card now sits under a section heading. */
  h3 {
    font-size: 17px;
    font-weight: 600;
    margin: 0;
  }

  /* Inline with the first line of the title rather than floated in a corner,
     so a wrapped title doesn't leave it stranded. Labelled, not aria-hidden —
     nothing else on the card says the project is a selected one. */
  .star {
    display: inline;
    vertical-align: -2px;
    margin-right: 6px;
    color: var(--accent);
  }

  /* Grows so the tag/link rows sit flush at the bottom of every card in a row. */
  .description {
    color: var(--text-secondary);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  /* Language sits above the tech tags and deliberately doesn't look like one:
     an accent dot and plain text rather than a bordered pill, so "what it's
     written in" reads differently from "what it touches". */
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  .language {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent);
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    border: 1px solid var(--border-tag);
    padding: 2px 8px;
    border-radius: 2px;
  }

  .links {
    display: flex;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    padding-top: 4px;
  }

  /* Optional Markdown body — most entries have none. */
  .card :global(.body) {
    color: var(--text-secondary);
    font-size: 14.5px;
    line-height: 1.6;
  }
</style>
