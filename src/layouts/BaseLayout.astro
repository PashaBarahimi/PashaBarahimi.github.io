---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '../styles/global.css';

// Preloaded so the real faces are in place before first paint. Without this,
// font-display: swap reflows the mono headings after FCP and CLS lands at 0.316
// on throttled mobile. Only the latin subsets that appear above the fold.
import monoRegular from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import monoSemibold from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import monoBold from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-700-normal.woff2?url';
import sansRegular from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';

const preloadFonts = [monoRegular, monoSemibold, monoBold, sansRegular];

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import { profile } from '../data';

interface Props {
  title: string;
  description?: string;
  /** Overrides the 900px column for pages that need a wider one (Projects uses
   *  1040px). Cascades to the footer too, so both stay aligned. */
  contentWidth?: string;
}

const { title, description = '', contentWidth } = Astro.props;

// Absolute URLs for canonical + social cards, derived from `site` in astro.config.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />

    {
      preloadFonts.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {/* Runs before first paint so the saved theme is applied with no flash.
        Dark is the default, so only 'light' needs an attribute — but we write
        either value back so the toggle's CSS state stays explicit.

        The `js` class gates anything that would strand a user without JS — the
        nav's collapsed mobile menu keys off it, so with scripting disabled the
        links stay visible instead of hiding behind a dead button. */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var saved = localStorage.getItem('site-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          /* storage unavailable — fall through to the dark default */
        }
      })();
    </script>
  </head>

  <body style={contentWidth ? `--content-width: ${contentWidth}` : undefined}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
