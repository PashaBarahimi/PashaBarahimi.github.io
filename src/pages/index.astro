---
import BaseLayout from '../layouts/BaseLayout.astro';
import DateTerms from '../components/DateTerms.astro';
import { profile, education, experience, teaching } from '../data';

const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

// Badge glyph / size / shape per link, matching design-reference/index.dc.html.
// Meta descriptions want ~155 chars; the bio's first sentence is the natural cut.
const metaDescription = `${profile.bio.split(/\.\s/)[0]}.`;

// Entries with no URL in profile.yaml are dropped rather than rendered dead.
const socials = [
  { label: 'email', href: profile.email && `mailto:${profile.email}`, glyph: '@', size: 10, round: false },
  { label: 'github', href: profile.github, glyph: 'gh', size: 9, round: false },
  { label: 'linkedin', href: profile.linkedin, glyph: 'in', size: 9, round: false },
  { label: 'scholar', href: profile.scholar, glyph: 'S', size: 10, round: false },
  { label: 'orcid', href: profile.orcid, glyph: 'iD', size: 8, round: true },
].filter((s): s is typeof s & { href: string } => Boolean(s.href));
---

<BaseLayout title={`${profile.name} — ${profile.tagline}`} description={metaDescription}>
  <section id="top" class="container hero">
    <div class="hero-aside">
      {
        profile.photo ? (
          <img class="photo" src={asset(profile.photo)} alt={profile.name} width="200" height="200" />
        ) : (
          <div class="photo photo-placeholder" role="img" aria-label={`Photo of ${profile.name}`}>
            <span aria-hidden="true">[photo]</span>
          </div>
        )
      }

      <div class="socials">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={s.href.startsWith('mailto:') ? undefined : 'noopener'}
            >
              <span
                class:list={['badge', { round: s.round }]}
                style={`font-size: ${s.size}px;`}
                aria-hidden="true"
              >
                {s.glyph}
              </span>
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero-main">
      <div class="terminal">
        {profile.terminalHost}:~$ <span
          id="typed"
          data-text={profile.terminalCommand}></span><noscript>{profile.terminalCommand}</noscript><span
          id="cursor"
          aria-hidden="true">▊</span>
      </div>

      <h1>{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <p id="about" class="bio">{profile.bio}</p>

      {/* Label names the file you get; cvPath is the route that forwards to it. */}
      <a class="cv" href={asset(profile.cvPath)}>↓ cv.pdf</a>
    </div>
  </section>

  <section id="education" class="container block">
    <div class="label">02 — education</div>
    <h2>Education</h2>
    <div class="entries">
      {
        education.map((item) => (
          <article class="dated">
            <div class="date">
              <DateTerms value={item.dateRange} />
            </div>
            <div>
              <h3>{item.title}</h3>
              <div class="institution">{item.institution}</div>
              {item.description && <div class="note">{item.description}</div>}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="experience" class="container block">
    <div class="label">03 — experience</div>
    <h2>Research &amp; Work Experience</h2>
    <div class="entries entries-wide">
      {
        experience.map((job) => (
          <article>
            <div class="job-head">
              <h3>{job.title}</h3>
              <div class="date">{job.dateRange}</div>
            </div>
            <div class="place">
              <svg
                class="pin"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>
                {job.organization}
                {job.location ? ` (${job.location})` : ''}
              </span>
            </div>
            {job.supervisor && <div class="job-meta">Supervisor: {job.supervisor}</div>}
            <ul class="bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section id="teaching" class="container block block-last">
    <div class="label">04 — teaching</div>
    <h2>Teaching Experience</h2>
    <div class="entries">
      {
        teaching.map((item) => (
          <article class="dated">
            <div class="date">
              <DateTerms value={item.dateRange} />
            </div>
            <div>
              <div class="course-head">
                <h3>{item.title}</h3>
                <span class="level">{item.level}</span>
              </div>
              <div class="institution">{item.institution}</div>
              {item.description && <div class="note">{item.description}</div>}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */

  .hero {
    padding-block: clamp(60px, 10vw, 120px) clamp(40px, 6vw, 72px);
    display: flex;
    gap: clamp(28px, 5vw, 56px);
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 0 0 auto;
    width: clamp(140px, 18vw, 200px);
  }

  .photo {
    width: 100%;
    height: clamp(140px, 18vw, 200px);
    border: 1px solid var(--border-tag);
    border-radius: 50%;
    object-fit: cover;
  }

  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: 12px;
    /* --text-tertiary on --bg-card is only 3.1:1 at this size (axe flagged it);
       --text-secondary clears AA. */
    color: var(--text-secondary);
  }

  .socials {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .socials a {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    border: 1px solid currentColor;
    border-radius: 3px;
  }

  .badge.round {
    border-radius: 50%;
  }

  .hero-main {
    flex: 1 1 480px;
    min-width: 280px;
  }

  /* Below ~760px the hero's own flex-wrap kicks in (140px aside + gap + the
     480px basis of .hero-main no longer fit), so the aside is alone on its
     row. Claim that whole row and lay the photo and contact links out side by
     side instead of stacked — the width: 100% also pins the wrap in place, so
     the two rules can't disagree near the boundary. This is the one spot
     clamp() + flex-wrap can't express on its own: the aside changes axis, not
     just size. */
  @media (max-width: 760px) {
    .hero-aside {
      width: 100%;
      flex-direction: row;
      align-items: center;
      gap: clamp(20px, 6vw, 32px);
    }

    .photo {
      flex: 0 0 auto;
      width: clamp(110px, 30vw, 160px);
      height: clamp(110px, 30vw, 160px);
    }

    .socials {
      flex: 1 1 auto;
      min-width: 0;
    }
  }

  .terminal {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.4vw, 15px);
    color: var(--text-tertiary);
    margin-bottom: 20px;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(38px, 7vw, 68px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: clamp(16px, 2.2vw, 20px);
    color: var(--accent);
    margin: 0 0 28px;
  }

  .bio {
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 0 32px;
    scroll-margin-top: 100px;
  }

  .cv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 3px;
  }

  .cv:hover {
    background: var(--accent-hover);
    color: var(--bg);
    text-decoration: none;
  }

  /* ---- Sections ---- */

  .block {
    padding-block: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--border);
  }

  .block-last {
    padding-bottom: clamp(70px, 10vw, 120px);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 8px;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    margin: 0 0 32px;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .entries-wide {
    gap: 36px;
  }

  /* Education / Teaching: mono date column + content column. The column has to
     clear the longest single date ("Sep 2020 — Sep 2025", 148px at this size);
     below that width DateTerms lets a lone term wrap instead of colliding with
     the title. Fixed per row, not auto, so the columns line up across entries. */
  .dated {
    display: grid;
    grid-template-columns: clamp(130px, 17vw, 155px) 1fr;
    gap: 20px;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-tertiary);
  }

  h3 {
    font-size: 17px;
    font-weight: 600;
    margin: 0;
  }

  /* Teaching only: course title with its audience pill alongside. Wraps to its
     own line rather than squeezing the title on narrow columns. */
  .course-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 10px;
  }

  /* Neutral rather than accent-coloured — it labels the course, it isn't a
     status worth pulling the eye off the title. --text-secondary, not the
     quieter --text-tertiary: at 11px tertiary measures 3.24:1 on --bg in dark,
     short of AA. */
  .level {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    border: 1px solid var(--border-tag);
    border-radius: 3px;
    padding: 2px 7px;
    white-space: nowrap;
  }

  .institution {
    color: var(--text-secondary);
    font-size: 15px;
    margin-top: 2px;
  }

  .note {
    color: var(--text-tertiary);
    font-size: 14px;
    margin-top: 6px;
  }

  /* Experience: title left, date right, bullets below. */
  .job-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 6px;
  }

  /* Organization on its own line under the title, with a map pin. `location`
     renders as a parenthetical rather than a separate item, so no separator can
     be stranded at the start of a wrapped line. */
  .place {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-bottom: 8px;
    font-size: 15px;
    color: var(--text-secondary);
  }

  /* Holds its size and stays level with the first line when a long
     organization name wraps — centring it would park the pin in the gap
     between the two lines. */
  .pin {
    flex: 0 0 auto;
    margin-top: 4px;
    color: var(--text-tertiary);
  }

  .job-meta {
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    /* --text-secondary, not the --text-tertiary used by the date column: at
       13px tertiary measures 3.24:1 on --bg in dark, short of AA. */
    color: var(--text-secondary);
  }

  .bullets {
    margin: 0;
    padding-left: 20px;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.7;
  }
</style>

<script>
  // Vanilla port of the hero terminal effect from design-reference/index.dc.html
  // (Component.componentDidMount): type the command out once at 110ms/char,
  // blink the cursor on a 550ms interval.
  const typed = document.getElementById('typed');
  const cursor = document.getElementById('cursor');

  if (typed && cursor) {
    const full = typed.dataset.text ?? '';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      typed.textContent = full;
    } else {
      let i = 0;
      const typeTimer = setInterval(() => {
        i++;
        typed.textContent = full.slice(0, i);
        if (i >= full.length) clearInterval(typeTimer);
      }, 110);

      let cursorOn = true;
      setInterval(() => {
        cursorOn = !cursorOn;
        cursor.style.opacity = cursorOn ? '1' : '0';
      }, 550);
    }
  }
</script>
