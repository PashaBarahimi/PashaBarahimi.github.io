---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data';

// Drafts are visible while developing, hidden in the production build.
const all = await getCollection('projects', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);

// Manual `order` ascending; ties fall back to filename so ordering is stable.
const projects = all.sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id)
);

// Render each Markdown body once here — most are empty.
const rendered = await Promise.all(
  projects.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content, hasBody: entry.body?.trim().length > 0 };
  })
);
---

<BaseLayout
  title={`Projects — ${profile.name}`}
  description={`Systems and security projects by ${profile.name}, with source, demo and paper links where available.`}
  contentWidth="1040px"
>
  <section class="container page">
    <div class="label">$ ls projects/</div>
    <h1>Projects</h1>

    <div class="grid">
      {
        rendered.map(({ entry, Content, hasBody }) => (
          <ProjectCard entry={entry}>
            {hasBody && (
              <div class="body">
                <Content />
              </div>
            )}
          </ProjectCard>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(50px, 8vw, 88px) clamp(70px, 10vw, 120px);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 8px;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(30px, 4.5vw, 44px);
    font-weight: 700;
    margin: 0 0 48px;
  }

  /* Column count comes from auto-fit + minmax alone — no breakpoints. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
</style>
