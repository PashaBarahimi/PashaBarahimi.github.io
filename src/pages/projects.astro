---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data';

// Drafts are visible while developing, hidden in the production build.
const all = await getCollection('projects', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);

// Featured first, then manual `order` ascending; ties fall back to filename so
// ordering is stable. Sorting globally is enough — the grouping below preserves
// this order inside each section.
const projects = all.sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    a.id.localeCompare(b.id)
);

// Render each Markdown body once here — most are empty.
const rendered = await Promise.all(
  projects.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content, hasBody: (entry.body?.trim().length ?? 0) > 0 };
  })
);

// Sections render in this order. Within each, the sort above still decides.
// A section with no entries doesn't render at all.
const sections = [
  { id: 'research', heading: 'Research' },
  { id: 'industry', heading: 'Industry' },
  { id: 'coursework', heading: 'Coursework' },
  { id: 'personal', heading: 'Personal' },
] as const;

const grouped = sections
  .map((section) => ({
    ...section,
    items: rendered.filter(({ entry }) => entry.data.category === section.id),
  }))
  .filter((section) => section.items.length > 0);
---

<BaseLayout
  title={`Projects — ${profile.name}`}
  description={`Systems and security projects by ${profile.name}, with source, demo and paper links where available.`}
  contentWidth="1040px"
>
  <section class="container page">
    <div class="label">$ ls projects/</div>
    <h1>Projects</h1>

    {
      grouped.map((section, i) => (
        <section class="group" id={section.id}>
          <div class="group-label">
            {String(i + 1).padStart(2, '0')} — {section.id}
          </div>
          <h2>{section.heading}</h2>

          <div class="grid">
            {section.items.map(({ entry, Content, hasBody }) => (
              <ProjectCard entry={entry}>
                {hasBody && (
                  <div class="body">
                    <Content />
                  </div>
                )}
              </ProjectCard>
            ))}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(50px, 8vw, 88px) clamp(70px, 10vw, 120px);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 8px;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(30px, 4.5vw, 44px);
    font-weight: 700;
    margin: 0 0 40px;
  }

  /* Same numbered-label rhythm as the home page sections, with a hairline
     between groups so the grid doesn't run together at a glance. */
  .group + .group {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: clamp(36px, 5vw, 56px);
    border-top: 1px solid var(--border);
  }

  .group-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 8px;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600;
    margin: 0 0 28px;
  }

  /* Column count comes from auto-fill + minmax alone — no breakpoints.
     auto-fill, not auto-fit: with the grid split across sections, auto-fit
     collapses the empty tracks, so a section holding fewer cards than a full
     row stretches them. Keeping the tracks holds every card to one width. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
</style>
